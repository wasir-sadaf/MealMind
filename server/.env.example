# Environment Variables for MealMind Server

# Database Configuration (Optional - app works with in-memory storage)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=guess_db

# Server Configuration
PORT=5000

# JWT Secret (for future authentication features)
JWT_SECRET=your_jwt_secret_key

# Email Configuration (for future email features)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password